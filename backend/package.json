{
  "name": "tikgrab-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API that resolves TikTok share links into watermark-free MP4 download URLs via a RapidAPI scraper service.",
  "main": "server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "keywords": [
    "tiktok",
    "downloader",
    "express",
    "rapidapi"
  ],
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0"
  }
}
